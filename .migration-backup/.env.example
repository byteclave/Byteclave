# Local database URL. Use a generated URL-safe hex password for Docker Compose.
DATABASE_URL=postgresql://byteclave:replace-with-a-64-character-hex-password@localhost:5432/byteclave

# Used by Docker Compose for the local PostgreSQL container. Generate with:
# openssl rand -hex 32
POSTGRES_PASSWORD=

# Used only by the explicit interactive Owner provisioning command.
# Email alone never grants an account Owner privileges.
INITIAL_OWNER_EMAIL=byteclave@gmail.com

# Generate with: openssl rand -base64 48
# Keep this value secret and use a different value for each installation.
SESSION_SECRET=

NODE_ENV=development
